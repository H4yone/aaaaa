# API Keys — kopyalayıp .env olarak kaydet, asla commit etme

# Anthropic (LLM)
ANTHROPIC_API_KEY=

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=

# TCMB EVDS
EVDS_API_KEY=

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DENIZ=
ELEVENLABS_VOICE_ID_MERT=

# YouTube Data API v3 (yükleme → OAuth2, metrikler → API Key)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=

# X (Twitter) API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
# metrics_fetcher.py'nin kullandığı isim (tweepy.Client):
TWITTER_BEARER_TOKEN=

# TikTok Content Posting API v2
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=

# CoinGecko (opsiyonel — ücretsiz demo key)
COINGECKO_API_KEY=

# Telegram (hata bildirimleri, opsiyonel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Uygulama ayarları
DB_PATH=media_network.db
OUTPUT_DIR=output
LOG_LEVEL=INFO
